{
  "schemaVersion": 1,
  "id": "framedblocks",
  "version": "${version}",
  "name": "FramedBlocks",
  "description": "Fabric port of FramedBlocks for Minecraft 1.20.5.",
  "authors": [
    "Lowei-7",
    "XFactHD"
  ],
  "contact": {
    "sources": "https://github.com/Lowei-7/FramedBlocks-Fabric",
    "issues": "https://github.com/Lowei-7/FramedBlocks-Fabric/issues"
  },
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xfacthd.framedblocks.FramedBlocks"
    ],
    "client": [
      "xfacthd.framedblocks.client.FBClient"
    ],
    "jade": [
      "xfacthd.framedblocks.common.compat.jade.FramedJadePlugin"
    ],
    "rei_plugins_v0": [
